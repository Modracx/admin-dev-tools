<?php
/** @var \Modracx\AdminDevTools\Block\Adminhtml\DevTools $block */
$tabs = $block->getTabs();
?>
<?php if (!empty($tabs)): ?>
<div class="modracx-root" id="modracx-root">

    <button type="button" class="modracx-launcher" id="modracx-launcher"
            aria-haspopup="dialog" aria-expanded="false" aria-controls="modracx-drawer"
            title="<?= $block->escapeHtmlAttr(__('Developer tools — drag to reposition')) ?>">
        <?php if ($block->canSeeCronBadge()): ?>
        <span class="modracx-health" id="modracx-health"
              data-badge-url="<?= $block->escapeHtmlAttr($block->getCronBadgeUrl()) ?>"></span>
        <?php endif; ?>
        <span class="modracx-launcher-label"><?= $block->escapeHtml(__('MODRACX')) ?></span>
        <svg class="modracx-caret" viewBox="0 0 10 6" fill="currentColor" width="8" height="8" aria-hidden="true">
            <path d="M0 0l5 6 5-6z"/>
        </svg>
    </button>

    <div class="modracx-backdrop" id="modracx-backdrop" hidden></div>

    <div class="modracx-drawer" id="modracx-drawer" role="dialog" aria-modal="true"
         aria-label="<?= $block->escapeHtmlAttr(__('Modracx developer tools')) ?>" hidden>

        <div class="modracx-drawer-head">
            <span class="modracx-drawer-brand"><?= $block->escapeHtml(__('MODRACX')) ?></span>

            <div class="modracx-drawer-tabs" role="tablist"
                 aria-label="<?= $block->escapeHtmlAttr(__('Tools')) ?>">
                <?php foreach ($tabs as $i => $tab): ?>
                <button type="button"
                        class="modracx-tab-btn<?= $i === 0 ? ' modracx-tab-active' : '' ?>"
                        role="tab"
                        id="modracx-tab-<?= $block->escapeHtmlAttr($tab['id']) ?>"
                        aria-selected="<?= $i === 0 ? 'true' : 'false' ?>"
                        aria-controls="modracx-drawer-panel"
                        tabindex="<?= $i === 0 ? '0' : '-1' ?>"
                        data-tab="<?= $block->escapeHtmlAttr($tab['id']) ?>"
                        data-url="<?= $block->escapeHtmlAttr($tab['url']) ?>"><?= $block->escapeHtml($tab['label']) ?></button>
                <?php endforeach; ?>
            </div>

            <button type="button" class="modracx-drawer-close" id="modracx-drawer-close"
                    aria-label="<?= $block->escapeHtmlAttr(__('Close')) ?>">
                <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" width="12" height="12" aria-hidden="true">
                    <path d="M2 2l10 10M12 2L2 12" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

        <div class="modracx-drawer-body">
            <div class="modracx-panel" id="modracx-drawer-panel" role="tabpanel"
                 data-url="<?= $block->escapeHtmlAttr($tabs[0]['url']) ?>"></div>
        </div>
    </div>
</div>
<script>
(function () {
    window.modracxDevTools.urls = <?= /* @noEscape */ json_encode($block->getActionUrls(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
}());
</script>
<?php endif; ?>
