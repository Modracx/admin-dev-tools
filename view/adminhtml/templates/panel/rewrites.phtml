<?php
/** @var \Modracx\AdminDevTools\Block\Adminhtml\Panel $block */
$path   = (string) $block->getData('path');
$result = $block->getData('result');
$error  = (string) $block->getData('error');
?>
<div class="modracx-panel-head">
    <span class="modracx-panel-title"><?= $block->escapeHtml(__('URL rewrites')) ?></span>
</div>

<div class="modracx-panel-form">
    <input type="text" class="modracx-input" id="modracx-rewrite-path"
           value="<?= $block->escapeHtmlAttr($path) ?>"
           placeholder="my-product.html"
           spellcheck="false" autocomplete="off">
    <button type="button" class="modracx-run-btn" id="modracx-rewrite-go"><?= $block->escapeHtml(__('Look up')) ?></button>
</div>

<?php if ($error !== ''): ?>
<div class="modracx-verdict modracx-verdict-err"><?= $block->escapeHtml($error) ?></div>
<?php elseif ($result === null): ?>
<div class="modracx-panel-empty">
    <?= $block->escapeHtml(__('Paste a request path or a full URL. Matches on both sides of the row — so a path that nothing serves still shows the rewrites pointing at it — and follows the redirect chain.')) ?>
</div>
<?php else: ?>

<?php if (!empty($result['loop'])): ?>
<div class="modracx-verdict modracx-verdict-err">
    <?= $block->escapeHtml(__('This path redirects in a loop. A browser will give up with ERR_TOO_MANY_REDIRECTS.')) ?>
</div>
<?php endif; ?>

<div class="modracx-section">
    <?= $block->escapeHtml(__('Rows matching %1 (%2)', $result['path'], count($result['rows']))) ?>
</div>
<?php if (empty($result['rows'])): ?>
<div class="modracx-panel-empty">
    <?= $block->escapeHtml(__('No rewrite mentions this path in either direction. If the page 404s, the rewrite was never generated — not overwritten.')) ?>
</div>
<?php else: ?>
<?php foreach ($result['rows'] as $row): ?>
<div class="modracx-row modracx-stack">
    <span class="modracx-item-name">
        <code class="modracx-code"><?= $block->escapeHtml($row['request_path']) ?></code>
        <em class="modracx-item-flag <?= $row['redirect_type'] !== 0 ? 'modracx-flag-warn' : '' ?>">
            <?= $block->escapeHtml($row['redirect_type'] === 0 ? __('internal') : __('%1 redirect', $row['redirect_type'])) ?>
        </em>
        <em class="modracx-item-flag"><?= $block->escapeHtml($row['store']) ?></em>
        <?php if (!$row['is_autogenerated']): ?>
        <em class="modracx-item-flag" title="<?= $block->escapeHtmlAttr(__('Created by hand or by import, not by Magento')) ?>">
            <?= $block->escapeHtml(__('custom')) ?>
        </em>
        <?php endif; ?>
        <em class="modracx-item-desc">
            → <code class="modracx-code"><?= $block->escapeHtml($row['target_path']) ?></code>
            <br><?= $block->escapeHtml($row['entity_type']) ?> #<?= $block->escapeHtml((string) $row['entity_id']) ?>
            <?php if ($row['description'] !== null && $row['description'] !== ''): ?>
            · <?= $block->escapeHtml($row['description']) ?>
            <?php endif; ?>
        </em>
    </span>
</div>
<?php endforeach; ?>
<?php endif; ?>

<?php if (!empty($result['chain'])): ?>
<div class="modracx-section"><?= $block->escapeHtml(__('Redirect chain')) ?></div>
<?php foreach ($result['chain'] as $i => $hop): ?>
<div class="modracx-row">
    <span class="modracx-item-name">
        <?= $block->escapeHtml(__('hop %1', $i + 1)) ?>
        <em class="modracx-item-desc">
            <code class="modracx-code"><?= $block->escapeHtml($hop['from']) ?></code>
            → <code class="modracx-code"><?= $block->escapeHtml($hop['to']) ?></code>
            · <?= $block->escapeHtml($hop['store']) ?>
        </em>
    </span>
</div>
<?php endforeach; ?>
<?php endif; ?>
<?php endif; ?>
