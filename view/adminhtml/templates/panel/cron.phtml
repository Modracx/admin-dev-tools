<?php
/** @var \Modracx\AdminDevTools\Block\Adminhtml\Panel $block */
$badge  = (array) $block->getData('badge');
$counts = (array) $block->getData('counts');
$groups = (array) $block->getData('groups');
$jobs   = (array) $block->getData('jobs');
$runs   = (array) $block->getData('runs');
$hours  = (int) $block->getData('recent_hours');
$days   = (int) $block->getData('success_days');
$canRun = (bool) $block->getData('can_run');
$runStatus = (string) $block->getData('run_status');
$queues = (array) $block->getData('queues');
$queuesAvailable = (bool) $block->getData('queues_available');

$runFilters = [
    'all'     => __('all'),
    'success' => __('success'),
    'error'   => __('error'),
    'missed'  => __('missed'),
];

$flagFor = static fn (?string $status): string => match ($status) {
    'success' => 'modracx-flag-ok',
    'error'   => 'modracx-flag-err',
    'missed'  => 'modracx-flag-warn',
    default   => '',
};
?>
<div class="modracx-panel-head">
    <span class="modracx-panel-title"><?= $block->escapeHtml(__('Cron — last %1 hours', $hours)) ?></span>
    <div class="modracx-panel-actions">
        <button type="button" class="modracx-run-btn modracx-panel-refresh"><?= $block->escapeHtml(__('Refresh')) ?></button>
    </div>
</div>

<div class="modracx-verdict modracx-verdict-<?= $block->escapeHtmlAttr((string) ($badge['level'] ?? 'ok')) ?>">
    <?= $block->escapeHtml((string) ($badge['detail'] ?? '')) ?>
</div>

<?php if (!empty($counts)): ?>
<div class="modracx-chips">
    <?php foreach ($counts as $status => $total): ?>
    <span class="modracx-chip modracx-chip-<?= $block->escapeHtmlAttr((string) $status) ?>">
        <?= $block->escapeHtml((string) $status) ?>
        <b><?= $block->escapeHtml((string) $total) ?></b>
    </span>
    <?php endforeach; ?>
</div>
<?php endif; ?>

<div class="modracx-section"><?= $block->escapeHtml(__('Groups')) ?></div>
<?php if (empty($groups)): ?>
<div class="modracx-panel-empty"><?= $block->escapeHtml(__('No cron groups configured.')) ?></div>
<?php else: ?>
<?php foreach ($groups as $group): ?>
<div class="modracx-row">
    <span class="modracx-item-name">
        <?= $block->escapeHtml($group['group']) ?>
        <em class="modracx-item-desc">
            <?php if ($group['last_success'] !== null): ?>
            <?= $block->escapeHtml(__('last success %1', $group['last_success'])) ?>
            <?php else: ?>
            <?= $block->escapeHtml(__('no success in the last 7 days')) ?>
            <?php endif; ?>
            · <?= $block->escapeHtml(__('%1 job(s)', $group['jobs'])) ?>
        </em>
    </span>
    <span class="modracx-item-counts">
        <?php if ($group['error'] > 0): ?>
        <em class="modracx-item-flag modracx-flag-err"><?= $block->escapeHtml(__('%1 error', $group['error'])) ?></em>
        <?php endif; ?>
        <?php if ($group['missed'] > 0): ?>
        <em class="modracx-item-flag modracx-flag-warn"><?= $block->escapeHtml(__('%1 missed', $group['missed'])) ?></em>
        <?php endif; ?>
        <?php if ($group['pending'] > 0): ?>
        <em class="modracx-item-flag"><?= $block->escapeHtml(__('%1 pending', $group['pending'])) ?></em>
        <?php endif; ?>
    </span>
</div>
<?php endforeach; ?>
<?php endif; ?>

<div class="modracx-section"><?= $block->escapeHtml(__('Jobs')) ?></div>
<?php if (!$canRun): ?>
<div class="modracx-panel-note">
    <?= $block->escapeHtml(__('Timings are measured over the last %1 days; counts over the last %2 hours.', $days, $hours)) ?>
</div>
<?php else: ?>
<div class="modracx-panel-note">
    <?= $block->escapeHtml(__('Run executes the job in this request, on this store, and records it in cron_schedule like a scheduled run. Long jobs may exceed the request timeout — the job keeps going, the panel stops waiting.')) ?>
</div>
<?php endif; ?>

<div class="modracx-panel-form">
    <input type="text" class="modracx-input modracx-filter" id="modracx-cron-filter"
           placeholder="<?= $block->escapeHtmlAttr(__('Filter by job or group…')) ?>"
           spellcheck="false" autocomplete="off">
</div>

<?php if (empty($jobs)): ?>
<div class="modracx-panel-empty"><?= $block->escapeHtml(__('No cron jobs are declared.')) ?></div>
<?php else: ?>
<div class="modracx-filter-list">
<?php foreach ($jobs as $job): ?>
<div class="modracx-row modracx-filter-row"
     data-filter="<?= $block->escapeHtmlAttr(strtolower($job['job_code'] . ' ' . $job['group'])) ?>">
    <span class="modracx-item-name">
        <?= $block->escapeHtml($job['job_code']) ?>
        <?php if ($job['last_status'] !== null): ?>
        <em class="modracx-item-flag <?= $block->escapeHtmlAttr($flagFor($job['last_status'])) ?>"
            title="<?= $block->escapeHtmlAttr(__('Last run: %1 UTC', (string) $job['last_run'])) ?>">
            <?= $block->escapeHtml($job['last_status']) ?>
            <?= $block->escapeHtml($block->formatAgo($job['last_run'])) ?>
        </em>
        <?php else: ?>
        <em class="modracx-item-flag" title="<?= $block->escapeHtmlAttr(__('Never run in the last %1 days', $days)) ?>">
            <?= $block->escapeHtml(__('never run')) ?>
        </em>
        <?php endif; ?>
        <em class="modracx-item-desc">
            <code class="modracx-code"><?= $block->escapeHtml($job['schedule']) ?></code>
            · <?= $block->escapeHtml($job['group']) ?>
            <?php if ($job['runs'] > 0): ?>
            · <?= $block->escapeHtml(__(
                'takes %1 avg, %2 worst over %3 run(s)',
                $block->formatDuration($job['avg_seconds']),
                $block->formatDuration($job['max_seconds']),
                $job['runs']
            )) ?>
            <?php endif; ?>
            <?php if ($job['error'] > 0 || $job['missed'] > 0): ?>
            · <?= $block->escapeHtml(__('%1 error / %2 missed in %3h', $job['error'], $job['missed'], $hours)) ?>
            <?php endif; ?>
            <?php if (!empty($job['last_message']) && $job['last_status'] === 'error'): ?>
            <br><?= $block->escapeHtml(mb_substr((string) $job['last_message'], 0, 300)) ?>
            <?php endif; ?>
        </em>
    </span>
    <?php if ($canRun): ?>
    <button type="button" class="modracx-run-btn modracx-cron-run-btn"
            data-job="<?= $block->escapeHtmlAttr($job['job_code']) ?>"><?= $block->escapeHtml(__('Run')) ?></button>
    <?php endif; ?>
</div>
<?php endforeach; ?>
</div>
<div class="modracx-panel-empty modracx-filter-empty" hidden><?= $block->escapeHtml(__('No job matches that filter.')) ?></div>
<?php endif; ?>

<div class="modracx-section"><?= $block->escapeHtml(__('Run history')) ?></div>
<div class="modracx-panel-actions modracx-run-filters">
    <?php foreach ($runFilters as $key => $label): ?>
    <button type="button"
            class="modracx-run-btn modracx-run-filter<?= $runStatus === $key ? ' modracx-tab-active' : '' ?>"
            data-run-status="<?= $block->escapeHtmlAttr($key) ?>"><?= $block->escapeHtml($label) ?></button>
    <?php endforeach; ?>
</div>

<?php if (empty($runs)): ?>
<div class="modracx-panel-empty">
    <?= $block->escapeHtml(__('No runs recorded in the last %1 days.', $days)) ?>
</div>
<?php else: ?>
<?php foreach ($runs as $run): ?>
<div class="modracx-row modracx-stack">
    <span class="modracx-item-name">
        <?= $block->escapeHtml((string) $run['job_code']) ?>
        <em class="modracx-item-flag <?= $block->escapeHtmlAttr($flagFor((string) $run['status'])) ?>">
            <?= $block->escapeHtml((string) $run['status']) ?>
        </em>
        <em class="modracx-item-desc">
            <span title="<?= $block->escapeHtmlAttr(__('Scheduled %1 UTC', (string) $run['scheduled_at'])) ?>">
                <?= $block->escapeHtml($block->formatAgo($run['finished_at'] ?: $run['scheduled_at'])) ?>
            </span>
            <?php if ($run['status'] === 'success' || $run['seconds'] !== null): ?>
            · <?= $block->escapeHtml(__('took %1', $block->formatDuration(
                $run['seconds'] === null ? null : (int) $run['seconds']
            ))) ?>
            <?php endif; ?>
            <?php if (!empty($run['messages'])): ?>
            — <?= $block->escapeHtml(mb_substr((string) $run['messages'], 0, 300)) ?>
            <?php endif; ?>
        </em>
    </span>
</div>
<?php endforeach; ?>
<?php endif; ?>

<div class="modracx-section"><?= $block->escapeHtml(__('Message queues')) ?></div>
<?php if (!$queuesAvailable): ?>
<div class="modracx-panel-empty">
    <?= $block->escapeHtml(__('MySQL queue tables are not present — this store uses an external broker such as RabbitMQ.')) ?>
</div>
<?php elseif (empty($queues)): ?>
<div class="modracx-panel-empty"><?= $block->escapeHtml(__('No messages in any queue.')) ?></div>
<?php else: ?>
<?php foreach ($queues as $queue): ?>
<div class="modracx-row">
    <span class="modracx-item-name">
        <?= $block->escapeHtml($queue['queue']) ?>
        <em class="modracx-item-desc">
            <?php $parts = []; foreach ($queue['counts'] as $label => $total) { $parts[] = $label . ': ' . $total; } ?>
            <?= $block->escapeHtml(implode(' · ', $parts)) ?>
        </em>
    </span>
    <?php if ($queue['problems'] > 0): ?>
    <em class="modracx-item-flag modracx-flag-err"><?= $block->escapeHtml((string) $queue['problems']) ?></em>
    <?php endif; ?>
</div>
<?php endforeach; ?>
<?php endif; ?>
