    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=103.0",
        "magento/module-backend": "*",
        "magento/module-indexer": "*",
        "magento/module-catalog": "*"
    },
    "suggest": {
        "modracx/mage-frontend-dev-tools": "The matching frontend-side developer toolbar"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Modracx\\AdminDevTools\\": ""
        }
    }
}
