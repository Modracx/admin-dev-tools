<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="modracx_flush_config" xsi:type="object">Modracx\AdminDevTools\Console\Command\FlushConfigCommand</item>
            </argument>
        </arguments>
    </type>

    <!--
        Captures outgoing mail at the transport, which is the last point where the message
        still exists as a rendered object. Global rather than per-area: mail is sent from
        the frontend, the admin, cron and consumers alike.
    -->
    <type name="Magento\Framework\Mail\TransportInterface">
        <plugin name="modracx_capture_mail" type="Modracx\AdminDevTools\Plugin\CaptureMail" sortOrder="10"/>
    </type>
</config>
